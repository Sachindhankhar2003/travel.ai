<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme (light only) -->
    <style name="Theme.CityGo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Android 12 SplashScreen -->
    <style name="Theme.CityGo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#7C5CFC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.CityGo</item>
    </style>
</resources>
